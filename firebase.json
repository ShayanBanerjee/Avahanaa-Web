{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "*.log",
        ".env",
        ".env.*"
      ]
    }
  ],
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "firestore.rules",
      "firestore.indexes.json",
      "DEPLOY.md",
      "README.md",
      ".git/**",
      ".firebase/**",
      "**/.*",
      "**/node_modules/**",
      "functions/**"
    ],
    "redirects": [
      {
        "source": "/notify.html",
        "destination": "/index.html?page=notify",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/api/qr/**",
        "function": "resolveQr",
        "region": "asia-south1"
      },
      {
        "source": "/api/notify",
        "function": "notify",
        "region": "asia-south1"
      },
      {
        "source": "/api/lookup",
        "function": "lookup",
        "region": "asia-south1"
      },
      {
        "source": "/api/status",
        "function": "status",
        "region": "asia-south1"
      },
      {
        "source": "/api/wallet/ssv",
        "function": "adSsv",
        "region": "asia-south1"
      },
      {
        "source": "/api/wallet/claim",
        "function": "walletClaim",
        "region": "asia-south1"
      },
      {
        "source": "/api/billing/verify",
        "function": "billingVerify",
        "region": "asia-south1"
      },
      {
        "source": "/api/alerts/test",
        "function": "selfTest",
        "region": "asia-south1"
      },
      {
        "source": "/n/**",
        "destination": "/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          }
        ]
      },
      {
        "source": "/api/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/n/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "hosting": {
      "port": 5055
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
